{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/vite-env.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/**/*.test.{ts,tsx}",
    "src/**/*.spec.{ts,tsx}",
    "src/test/**",
    "public/mockServiceWorker.js"
  ],
  "ignoreDependencies": [
    "@types/jest-axe",
    "@axe-core/react"
  ],
  "ignoreExportsUsedInFile": true,
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": ["src/**/*.{test,spec}.{ts,tsx}", "src/test/setup.ts"]
  }
}
