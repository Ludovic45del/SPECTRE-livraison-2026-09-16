# =============================================================================
#  SPECTRE Backend — variables d'environnement
# =============================================================================
#  Copier ce fichier en `backend/.env` puis renseigner les valeurs.
#  Chargé automatiquement par config/settings.py (python-dotenv, override=False :
#  une vraie variable d'environnement a toujours priorité sur le .env).
#
#  Liste EXHAUSTIVE de toutes les variables lues par le code (os.environ).
#  Deux profils types sont donnés :
#    • [AIR-GAP]  déploiement RHEL 9 SQLite (serveur CEA sans internet)
#    • [DEV/PG]   développement local ou prod PostgreSQL
# =============================================================================


# =============================================================================
#  OBLIGATOIRE EN PRODUCTION
# =============================================================================

# Clé secrète Django. OBLIGATOIRE hors DEBUG (sinon le démarrage lève une erreur).
# Générer avec :
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=

# Hôtes autorisés (séparés par des virgules). Mettre le nom DNS et/ou l'IP du
# serveur. Défaut : localhost,127.0.0.1
# [AIR-GAP] ex. ALLOWED_HOSTS=spectre.intra.cea.fr,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1


# =============================================================================
#  BASE DE DONNÉES
# =============================================================================

# Sélecteur de moteur. Booléen STRICT : accepte True/true/1 (et False/0) ;
# toute autre valeur (faute de frappe) lève une erreur au démarrage — pas de
# bascule silencieuse.
#   USE_SQLITE=True   → SQLite   [AIR-GAP]  (aucun driver PostgreSQL requis)
#   USE_SQLITE=False  → PostgreSQL [DEV/PG] (bloc DB_* ci-dessous obligatoire)
USE_SQLITE=True

# ---- [AIR-GAP] SQLite (utilisé uniquement si USE_SQLITE=True) ----
# Chemin du fichier SQLite. Défaut : backend/db.sqlite3
# Recommandé en prod : chemin absolu hors de l'arborescence servie par Apache.
# ex. SQLITE_PATH=/opt/spectre/data/db.sqlite3
SQLITE_PATH=

# ---- [DEV/PG] PostgreSQL (utilisé uniquement si USE_SQLITE=False) ----
# DB_NAME est OBLIGATOIRE dans ce mode (sinon erreur au démarrage).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=spectre
DB_USER=spectre
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Persistance des connexions PG (secondes). Défaut : 60. (Sans effet en SQLite.)
DB_CONN_MAX_AGE=60

# Transaction par requête HTTP (rollback propre en cas d'échec). Booléen strict.
# Défaut : True. Vaut pour les deux moteurs.
DB_ATOMIC_REQUESTS=True


# =============================================================================
#  FICHIERS STATIQUES & MÉDIAS
# =============================================================================

# Destination de `collectstatic` (servie par whitenoise et/ou Apache).
# Défaut : backend/staticfiles
# [AIR-GAP] ex. STATIC_ROOT=/opt/spectre/backend/staticfiles
STATIC_ROOT=

# URL publique des médias uploadés (photos FSEC/FA, avatars, signatures).
# Défaut : /api/media/  (en prod c'est Apache qui sert cette URL depuis MEDIA_ROOT).
MEDIA_URL=/api/media/

# Dossier disque des médias uploadés. Défaut : backend/media
# [AIR-GAP] ex. MEDIA_ROOT=/opt/spectre/backend/media
MEDIA_ROOT=


# =============================================================================
#  CACHE
# =============================================================================
# Défaut : cache mémoire local (mono-process). Suffisant pour gunicorn mono-worker.
# En multi-worker, basculer sur Redis (nécessiterait le paquet redis, hors air-gap).
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=spectre-default
CACHE_TIMEOUT=300


# =============================================================================
#  SÉCURITÉ / JWT / CORS
# =============================================================================

# Clé de signature JWT. Défaut : DJANGO_SECRET_KEY. Laisser vide = réutilise la
# clé secrète (recommandé sauf besoin de rotation indépendante).
JWT_SIGNING_KEY=

# Redirection HTTP → HTTPS (actif seulement hors DEBUG). Booléen. Défaut : True.
# [AIR-GAP] si Apache sert en HTTP interne (TLS géré en amont par l'IT, ou réseau
# fermé sans TLS), METTRE False pour éviter une boucle de redirection.
SECURE_SSL_REDIRECT=False

# Origines navigateur autorisées (CORS), séparées par des virgules.
# En prod mono-domaine (Apache sert le front ET proxy /api sur la même origine),
# CORS n'est en principe pas sollicité, mais renseigner l'URL d'accès par sûreté.
# Défaut : http://localhost:5173,http://localhost:3000
# [AIR-GAP] ex. CORS_ALLOWED_ORIGINS=https://spectre.intra.cea.fr
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# =============================================================================
#  MODE DEBUG (JAMAIS "true" en production)
# =============================================================================
# Booléen. Défaut : False. Le nom EST « DEBUG » (et non « DJANGO_DEBUG »).
# En DEBUG : /admin/ est monté, SessionAuthentication activée, clé secrète de
# secours autorisée, médias servis par Django. À laisser False en prod.
DEBUG=False


# =============================================================================
#  SEED DU COMPTE ADMIN DE DEV (migration 0044 — optionnel)
# =============================================================================
# Ne PAS utiliser en production : créer le premier compte via
#   python manage.py createadmin <username>
#
# SPECTRE_SEED_DEV_ADMIN=1 déclenche la création d'un compte "admin" lors de
# `migrate` (dev uniquement). Mot de passe : SPECTRE_SEED_DEV_ADMIN_PASSWORD
# (sinon généré aléatoirement et loggé une fois).
# SPECTRE_SEED_DEV_ADMIN=
# SPECTRE_SEED_DEV_ADMIN_PASSWORD=
