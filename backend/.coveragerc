[run]
source = app
branch = true
omit =
    */migrations/*
    */tests/*
    */__init__.py
    */admin.py
    */apps.py
    */manage.py
    config/*

[report]
fail_under = 80
show_missing = true
skip_covered = false
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
